{
  "name": "linloop",
  "version": "0.1.0",
  "private": true,
  "description": "Spotlight-like English typing box that refines with Ollama and learns stored words/patterns.",
  "author": "linloop",
  "main": "compiled/src/main/main.js",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "start": "bun run build && electron .",
    "icon": "bun scripts/make-icon.ts",
    "verify:ui": "bun run build && electron compiled/scripts/verify-electron.js",
    "verify:flow": "bun scripts/verify-flow.ts",
    "verify:store": "bun scripts/smoke-store.ts",
    "dist": "bun run build && bun run icon && electron-builder --publish never",
    "dist:mac": "bun run build && bun run icon && electron-builder --mac dmg zip --publish never",
    "dist:win": "bun run build && bun run icon && electron-builder --win nsis --publish never",
    "version:set": "bun scripts/set-version.ts",
    "version:bump": "bun scripts/bump-version.ts"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@types/node": "26.6.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "app.linloop.desktop",
    "productName": "Linloop",
    "copyright": "Copyright © linloop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "compiled/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "asar": true,
    "afterPack": "scripts/sign-mac.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "artifactName": "Linloop-${version}-mac.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Linloop",
      "artifactName": "Linloop-Setup-${version}.${ext}"
    }
  }
}
