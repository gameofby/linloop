{
  "name": "linloop",
  "version": "0.3.0",
  "private": true,
  "description": "Plain Markdown writing editor with integrated Ollama and MLX local AI.",
  "author": "linloop",
  "main": "compiled/src/main/main.js",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "start": "bun run build && electron .",
    "icon": "bun scripts/make-icon.ts",
    "verify:ui": "bun run build && electron compiled/scripts/verify-electron.js",
    "verify:settings": "bun run build && electron compiled/scripts/verify-settings.js",
    "verify:drag": "bun scripts/verify-window-drag.ts",
    "verify:window": "bun run build && electron compiled/scripts/verify-window.js",
    "verify:translation": "bun run build && electron compiled/scripts/verify-translation.js",
    "verify:responses": "bun scripts/verify-responses.ts",
    "verify:results": "bun run build && electron compiled/scripts/verify-results.js",
    "verify:speech": "bun run build && electron compiled/scripts/verify-speech.js",
    "verify:flow": "bun scripts/verify-flow.ts",
    "verify:store": "bun scripts/smoke-store.ts",
    "dist": "bun run dist:mac",
    "dist:mac": "bun run build && bun run icon && electron-builder --mac dmg zip --publish never",
    "version:set": "bun scripts/set-version.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "verify:language": "bun run build && bun compiled/scripts/verify-language.js",
    "verify:local-ai": "bun scripts/verify-local-ai.ts",
    "verify:ai-settings": "bun run build && electron compiled/scripts/verify-ai-settings.js",
    "verify:model-download": "python3 scripts/verify-model-download.py"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@types/node": "26.6.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "app.linloop.desktop",
    "productName": "Linloop",
    "copyright": "Copyright © linloop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "compiled/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "asarUnpack": [
      "compiled/native/**/*"
    ],
    "asar": true,
    "afterPack": "scripts/sign-mac.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "minimumSystemVersion": "14.0"
    },
    "dmg": {
      "artifactName": "Linloop-${version}-mac.${ext}"
    }
  }
}
